# Copy to .env for local overrides (docker-compose already sets dev defaults).
#
# dotenv-rails loads this file in development AND test, so everything here is a
# development value that the test environment must not inherit. spec/rails_helper.rb
# forces DATABASE_PATH and AI_MODE back to safe values before the app boots —
# do not remove that guard.

# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
DATABASE_PATH=storage/development.sqlite3

# Auth
JWT_SECRET=change-me-in-production

# CORS (comma-separated origins allowed to call /api/*)
CORS_ORIGINS=http://localhost:4200

# Mail (Mailpit in dev)
APP_HOST=localhost
APP_PORT=3001
APP_FRONTEND_URL=http://localhost:4200
MAILER_DOMAIN=example.com
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025

# Active Storage (MinIO in dev, Tigris/S3 in prod)
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=http://minio:9000
AWS_S3_FORCE_PATH_STYLE=true
BUCKET_NAME=restlify-files

# Production SMTP (set as Fly secrets, not here)
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Scrapless: model provider ------------------------------------------------
# Unset -> the app runs against Ai::Stub (clickable, zero spend).
OPENAI_API_KEY=
# auto | live | stub
AI_MODE=auto
# Overrides for the defaults in app/services/ai/config.rb.
# AI_MODEL_RECEIPT_EXTRACT=gpt-5-mini
# AI_MODEL_TEXT_PARSE=gpt-5-nano
# AI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe

# --- Failover chain -----------------------------------------------------------
# Providers are tried in order and fall back on quota/credential/outage errors
# (never on a bad answer — paying twice for the same nonsense helps nobody).
# With no AI_PROVIDERS set, the chain is every provider that has a key, in the
# order openai, gemini, groq. `local` is opt-in only, never auto-detected.
# AI_PROVIDERS=openai,gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# Point `local` at Ollama / llama.cpp / LM Studio:
# AI_PROVIDERS=local
# AI_BASE_URL_LOCAL=http://localhost:11434/v1
